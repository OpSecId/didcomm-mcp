# didcomm-mcp for Railway: serves MCP over Streamable HTTP at https://<domain>/mcp, and
# receives DIDComm messages at https://<domain>/didcomm (no mediator needed).
#
# Differs from ./Dockerfile only where Railway's builder requires it:
#   - no RUN --mount (Railway rejects secret mounts, and cache mounts need a
#     service-specific id); wyvrn-cloud/didcomm is public, so no token is needed
#   - no VOLUME: with a Postgres database attached, nothing is kept on disk
#   - binds 0.0.0.0:$PORT and runs with --http by default
#
# Railway variables:
#   DIDCOMM_MCP_HTTP_TOKEN    required: the bearer token MCP clients send
#   DATABASE_URL              ${{Postgres.DATABASE_URL}}: identity, connections and inbox
#                             live there. Without it they're files under /data, lost on
#                             redeploy unless a Railway Volume is mounted at /data.
#   DIDCOMM_MCP_PUBLIC_URL    defaults to https://$RAILWAY_PUBLIC_DOMAIN; set it for a
#                             custom domain. The agent's DID names <url>/didcomm.
#   DIDCOMM_MCP_HTTP_ALLOWED_HOSTS  defaults to the public URL's host
#   DIDCOMM_MCP_MEDIATOR_DID / DIDCOMM_MCP_V1_MEDIATOR / DIDCOMM_MCP_REGISTRY_DID: see
#                             README ("" disables each)
FROM rust:1-slim-bookworm AS builder

# git: cargo fetches the didcomm git dependency with the git CLI (.cargo/config.toml).
# cmake/gcc/perl: aws-lc-rs (rustls' crypto provider) builds a C library.
RUN apt-get update && apt-get install -y --no-install-recommends git cmake gcc perl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY .cargo .cargo
COPY src src

# aws-lc-rs' cmake build ignores cargo's -j; cap it so constrained builders don't OOM.
ENV CMAKE_BUILD_PARALLEL_LEVEL=2
RUN cargo build --release --locked -j 2 --bin didcomm-mcp

FROM debian:bookworm-slim
# ca-certificates: HTTPS to peers, mediators, did:web documents and the database.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /data
COPY --from=builder /build/target/release/didcomm-mcp /usr/local/bin/didcomm-mcp
COPY railway-start.sh /usr/local/bin/railway-start.sh
# Only used without DATABASE_URL.
ENV DIDCOMM_MCP_IDENTITY=/data/identity.json
EXPOSE 8090
# Runs as root: if a Railway Volume is used instead of Postgres, it mounts root-owned.
CMD ["sh", "/usr/local/bin/railway-start.sh"]
